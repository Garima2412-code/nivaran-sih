# Gemini API key.
# Leave empty to use deterministic fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used by JanSahay AI.
GEMINI_MODEL=gemini-3.6-flash

# Duplicate detection
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
DUPLICATE_SIMILARITY_THRESHOLD=0.80
DUPLICATE_SIMILARITY_THRESHOLD_TFIDF=0.45

# Issue clustering
CLUSTER_SIMILARITY_THRESHOLD=0.75
CLUSTER_SIMILARITY_THRESHOLD_TFIDF=0.35

# API request timeout
REQUEST_TIMEOUT_SECONDS=20